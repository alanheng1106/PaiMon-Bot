DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
OWNER_ID=

# Lavalink Configuration
# For local docker-compose: LAVALINK_HOST=lavalink
# For Pterodactyl (Same Node / No Public IP): set LAVALINK_HOST=172.17.0.1 (Docker Bridge IP) or Node Internal LAN IP
# For Pterodactyl (Different Nodes / Public IP): set LAVALINK_HOST to Lavalink server IP/domain
LAVALINK_HOST=172.17.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# AI Configuration
HF_TOKEN=
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=llava
SERPER_API_KEY=

# Valorant Token Encryption Key (AES-256)
# If left empty, DISCORD_TOKEN will be used as a fallback seed.
ENCRYPTION_KEY=
