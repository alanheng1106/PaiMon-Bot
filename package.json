{
  "name": "paimon-bot",
  "version": "1.0.0",
  "description": "Next-Gen Discord Bot with Windowsed GenAI Gateway, SDXL Image Generation, and Lavalink Music Support",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "test": "bun test",
    "postinstall": "bun scripts/patch-unpdf.js",
    "format": "prettier --write \"**/*.{js,ts}\""
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "@napi-rs/canvas": "^1.0.10",
