    "shoukaku": "^4.3.0",
    "unpdf": "^1.8.1"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.70.0"
